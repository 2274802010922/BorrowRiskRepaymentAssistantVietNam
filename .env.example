# UI examples work without configuration. All execution is Devnet-only.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Configure a verified market/reserve pair after the Devnet gate.
KAMINO_MARKET_ID=
KAMINO_COLLATERAL_RESERVE=
KAMINO_DEBT_RESERVE=
# Server-only, at least 32 random characters. Not a wallet key.
PLAN_BINDING_SECRET=
# Optional model explanation; keep disabled until rate limits/billing are configured.
AI_ENABLED=false
AI_MODEL=
OPENAI_API_KEY=
